FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    git \
    build-essential \
    cmake \
    python3 \
    python3-pip \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --upgrade pip setuptools wheel
RUN pip3 install numpy jinja2 pytest parameterized sympy
RUN pip3 install torch --index-url https://download.pytorch.org/whl/cpu

# Build and install XNNPACK for the CPU backend.
RUN git clone --depth 1 https://github.com/google/XNNPACK.git /tmp/XNNPACK \
    && cmake -S /tmp/XNNPACK -B /tmp/XNNPACK/build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
        -DXNNPACK_LIBRARY_TYPE=shared \
        -DXNNPACK_BUILD_TESTS=OFF \
        -DXNNPACK_BUILD_BENCHMARKS=OFF \
        -DXNNPACK_BUILD_ALL_MICROKERNELS=OFF \
    && cmake --build /tmp/XNNPACK/build -j"$(nproc)" \
    && cmake --install /tmp/XNNPACK/build \
    && ldconfig \
    && rm -rf /tmp/XNNPACK

ENV PYTHONPATH=/workspace/AITemplate/python

WORKDIR /workspace/AITemplate

CMD ["/bin/bash"]
